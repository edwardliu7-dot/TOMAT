# Salin file ini menjadi .env di VPS, lalu isi nilai-nilainya
# cp .env.example .env

# ── Database (Neon PostgreSQL) ─────────────────────────────────
# Salin dari Replit Secrets: NEON_DATABASE_URL
NEON_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Session ────────────────────────────────────────────────────
# String acak panjang, misal: openssl rand -base64 32
SESSION_SECRET=ganti-dengan-string-acak-yang-panjang

# ── Web Push / VAPID (opsional, untuk notifikasi push) ────────
# Salin dari Replit Secrets jika ada
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── Force Update APK ───────────────────────────────────────────
# Naikkan angka ini saat rilis APK baru yang wajib diupdate
MIN_APP_VERSION_CODE=1
# Link download APK terbaru (dari GitHub Releases)
APP_DOWNLOAD_URL=https://github.com/USERNAME/REPO/releases/latest/download/tomat.apk
